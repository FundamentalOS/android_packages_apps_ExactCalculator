<!-- The overflow menu shrinks back into its top end corner. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/standard">
    <scale
        android:duration="@integer/overflow_menu_exit_duration"
        android:fromXScale="1"
        android:fromYScale="1"
        android:pivotX="100%"
        android:pivotY="0%"
        android:toXScale="0.6"
        android:toYScale="0.6" />
    <alpha
        android:duration="@integer/overflow_menu_exit_duration"
        android:fromAlpha="1"
        android:toAlpha="0" />
</set>
