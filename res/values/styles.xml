<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="DisplayTextStyle" parent="Widget.MaterialComponents.TextView">
        <item name="android:cursorVisible">false</item>
        <item name="fontFamily">@font/google_sans_flex</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">bottom|end</item>
        <item name="android:textAlignment">viewEnd</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- The formula is an EditText, with a blinking cursor at its end; see CalculatorFormula. -->
    <style name="DisplayTextStyle.Formula">
        <item name="android:cursorVisible">true</item>
        <item name="android:paddingTop">@dimen/formula_padding_top</item>
        <item name="android:paddingBottom">@dimen/formula_padding_bottom</item>
        <item name="android:paddingStart">@dimen/formula_padding_start</item>
        <item name="android:paddingEnd">@dimen/formula_padding_end</item>
        <item name="android:gravity">bottom</item>
        <item name="minTextSize">@dimen/formula_min_textsize</item>
        <item name="maxTextSize">@dimen/formula_max_textsize</item>
        <item name="stepTextSize">@dimen/formula_step_textsize</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="DisplayTextStyle.Result">
        <item name="android:paddingTop">@dimen/result_padding_top</item>
        <item name="android:paddingBottom">@dimen/result_padding_bottom</item>
        <item name="android:paddingStart">@dimen/result_padding_start</item>
        <item name="android:paddingEnd">@dimen/result_padding_end</item>
        <item name="android:gravity">bottom</item>
        <item name="android:textSize">@dimen/result_textsize</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- The exact fraction under a result: the result's slot and size, with the digits laid out
         as a fraction by the font. -->
    <style name="DisplayTextStyle.Fraction" parent="DisplayTextStyle.Result">
        <item name="android:fontFeatureSettings">frac</item>
    </style>

    <style name="HistoryItemTextStyle" parent="DisplayTextStyle">
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:paddingTop">@dimen/history_item_text_padding_top</item>
        <item name="android:paddingBottom">@dimen/history_item_text_padding_bottom</item>
        <!-- Note: result_padding_start == formula_padding_start. -->
        <item name="android:paddingStart">@dimen/result_padding_start</item>
        <item name="android:paddingEnd">@dimen/result_padding_end</item>
        <item name="android:textSize">@dimen/result_textsize</item>
    </style>

    <!-- Every gap is twice the key margin: pads are padded by one margin on their outer edges
         and not at all where they meet each other. Equal margins keep the numeric pad's cells
         square when the pad is 4:5, i.e. the keys circular. -->
    <style name="KeypadStyle">
        <item name="keyMargin">@dimen/button_horizontal_margin</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">@dimen/pads_vertical_edge_padding</item>
        <item name="android:paddingStart">@dimen/pads_horizontal_edge_padding</item>
        <item name="android:paddingEnd">@dimen/pads_horizontal_edge_padding</item>
    </style>

    <style name="KeypadStyle.Advanced">
        <item name="android:paddingTop">@dimen/pads_vertical_edge_padding</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">@dimen/pads_horizontal_edge_padding</item>
        <item name="android:paddingEnd">@dimen/pads_horizontal_edge_padding</item>
    </style>

</resources>
