<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/overflow_menu_item_height"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/overflow_menu_item_padding_start"
    android:paddingEnd="@dimen/overflow_menu_item_padding_end">

    <ImageView
        android:id="@+id/overflow_menu_icon"
        android:layout_width="@dimen/overflow_menu_icon_size"
        android:layout_height="@dimen/overflow_menu_icon_size"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/overflow_menu_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/overflow_menu_icon_gap"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />

</LinearLayout>
