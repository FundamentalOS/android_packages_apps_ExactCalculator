<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:orientation="vertical">

    <!-- Just the title, aligned with the calculator toolbar's history button: no navigation
         icon, and the actions live in the display's overflow menu. The height is fixed (plus
         the status bar inset, added at runtime) so that the title stays put while the panel
         is being pulled shorter than the toolbar. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/history_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_history" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/history_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="@dimen/history_divider_padding"
        app:layoutManager="LinearLayoutManager"
        app:reverseLayout="true" />

</LinearLayout>
