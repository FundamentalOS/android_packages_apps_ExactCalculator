<!-- Material 3 state layer: the button's content colour at 12% for pressed and focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.12" android:color="?attr/colorOnContainer" android:state_pressed="true" />
    <item android:alpha="0.12" android:color="?attr/colorOnContainer" android:state_focused="true" />
    <item android:alpha="0.08" android:color="?attr/colorOnContainer" android:state_hovered="true" />
    <item android:alpha="0.12" android:color="?attr/colorOnContainer" />
</selector>
